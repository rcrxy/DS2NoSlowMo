{
    "configurations": [
        {
            "name": "CMake",
            "configurationProvider": "ms-vscode.cmake-tools",
            "windowsSdkVersion": "10.0.26100.0",
            "includePath": [
                "${workspaceFolder}/src"
            ],
            "defines": [
                "WIN32_LEAN_AND_MEAN",
                "NOMINMAX",
                "_DEBUG"
            ],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "msvc-x64"
        }
    ],
    "version": 4
}
