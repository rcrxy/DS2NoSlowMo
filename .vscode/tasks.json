{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build ASI (Debug)",
            "type": "process",
            "command": "${env:ComSpec}",
            "args": ["/d", "/c", "do_build.bat", "Debug"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": ["$msCompile"],
            "group": {"kind": "build", "isDefault": true}
        },
        {
            "label": "Build ASI (Release)",
            "type": "process",
            "command": "${env:ComSpec}",
            "args": ["/d", "/c", "do_build.bat", "Release"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": ["$msCompile"],
            "group": "build"
        }
    ]
}
